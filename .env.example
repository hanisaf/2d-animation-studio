# Copy to .env for API-key authentication. Leave blank for interactive login.
# Never commit real credentials. Keys are injected only into the agents service.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional host port and exact npm CLI version overrides.
STUDIO_PORT=5173
CODEX_VERSION=latest
CLAUDE_VERSION=latest
GEMINI_VERSION=latest
