# ---- rendered output (everything the renderer makes is regenerable: node render.mjs / scripts/build_*.sh) ----
out/
frames/
stills/
*.tmp
brag-output/
# rendered animations, wherever they end up
*.mp4
*.mov
*.m4v
*.webm
*.mkv
*.avi
*.gif

# rendered stills / contact sheets outside out/ (reference art in characters/ and locations/ is kept)
*.png
*.jpg
*.jpeg
!characters/**/*.png
!characters/**/*.jpg
!characters/**/*.jpeg
!locations/**/*.png
!locations/**/*.jpg
!locations/**/*.jpeg
!docs/**/*.png
!docs/**/*.jpg
!assets/*.jpg
# source art a scene draws at render time
!scenes/**/costumes/*.png
!scenes/the_trolls/scene47_troll_analytics/alma_monsters.jpg

# comic source art, style anchors, studio picture outputs, active/approved illustrated outputs, and print PDFs
!comics/**/style_refs/*.png
!comics/**/style_refs/*.jpg
!comics/**/style_refs/*.jpeg
!comics/**/style_refs/*.webp
!comics/*/*/*.png
!comics/*/*/*.jpg
!comics/*/*/*.jpeg
!comics/*/*/*.webp
!comics/**/studio/*.png
!comics/**/studio/*.jpg
!comics/**/studio/*.jpeg
!comics/**/studio/*.webp
!comics/**/illustrated/*.png
!comics/**/illustrated/*.jpg
!comics/**/illustrated/*.jpeg
!comics/**/illustrated/*.webp
!comics/*/*/out/
comics/*/*/out/*
!comics/*/*/out/*.pdf

# historical Gemini take cache
comics/**/illustrated/takes/
comics/**/illustrated/index.json

# regenerable comic-to-video frames, overlays, Veo take cache & assembled subtitles (keep video/storyboard.json tracked)
comics/**/video/frames/
comics/**/video/overlays/
comics/**/video/takes/
comics/**/video/clips/
comics/**/video/index.json
comics/**/video/frames_sheet*.jpg
comics/**/video/.assemble_tmp/
comics/**/out/*.srt

# ---- dependencies (reinstall with: npm install; ffmpeg-static is OS-specific) ----
node_modules/

# ---- logs, OS and editor clutter ----
npm-debug.log*
*.log
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
.env
%SystemDrive%
# Local container credentials
.env.*
!.env.example
