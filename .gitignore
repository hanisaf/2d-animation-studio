# ---- rendered output (everything the renderer makes is regenerable: node render.mjs / scripts/build_*.sh) ----
out/
frames/
stills/
*.tmp

# rendered animations, wherever they end up
*.mp4
*.mov
*.m4v
*.webm
*.mkv
*.avi
*.gif

# rendered stills / contact sheets outside out/ (reference art in characters/ and locations/ is kept)
*.png
*.jpg
*.jpeg
!characters/**/*.png
!characters/**/*.jpg
!characters/**/*.jpeg
!locations/**/*.png
!locations/**/*.jpg
!locations/**/*.jpeg
!docs/**/*.png
!docs/**/*.jpg

# ---- dependencies (reinstall with: npm install; ffmpeg-static is OS-specific) ----
node_modules/

# ---- logs, OS and editor clutter ----
npm-debug.log*
*.log
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
.env
