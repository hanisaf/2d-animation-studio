{
  "name": "safadi-animation-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Safadi Animation Studio: 2D cartoons animated in code, rendered in headless Chrome and encoded with ffmpeg.",
  "scripts": {
    "studio": "node serve.mjs --open",
    "serve": "node serve.mjs",
    "scene": "node render.mjs",
    "movie": "node render.mjs --movie",
    "doctor": "node render.mjs --doctor"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "mp4-muxer": "^5.2.2",
    "puppeteer-core": "^24.0.0"
  }
}
